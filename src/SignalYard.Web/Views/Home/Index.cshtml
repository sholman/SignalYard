@model LogViewerViewModel
@{
    ViewData["Title"] = "Log Viewer";
}

<div class="log-viewer">
    <form method="get" asp-action="Index" id="searchForm">
        <div class="toolbar">
            <div class="toolbar-row">
                <div class="filter-group">
                    <label>Application</label>
                    <select name="Application" id="applicationSelect">
                        <option value="">All Applications</option>
                        @foreach (var app in Model.Applications)
                        {
                            <option value="@app.Name" selected="@(Model.SelectedApplication == app.Name)">@app.Name</option>
                        }
                    </select>
                </div>
                
                <div class="filter-group">
                    <label>Time Range</label>
                    <div class="time-range-buttons">
                        <button type="button" class="btn btn-sm @(Model.SelectedTimeRange == "24h" ? "btn-active" : "btn-secondary")" 
                                onclick="selectTimeRange('24h')">24h</button>
                        <button type="button" class="btn btn-sm @(Model.SelectedTimeRange == "7d" ? "btn-active" : "btn-secondary")" 
                                onclick="selectTimeRange('7d')">7d</button>
                        <button type="button" class="btn btn-sm @(Model.SelectedTimeRange == "30d" ? "btn-active" : "btn-secondary")" 
                                onclick="selectTimeRange('30d')">30d</button>
                        <button type="button" class="btn btn-sm @(Model.SelectedTimeRange == "custom" ? "btn-active" : "btn-secondary")" 
                                onclick="selectTimeRange('custom')">Custom</button>
                    </div>
                    <input type="hidden" name="TimeRange" id="timeRangeInput" value="@Model.SelectedTimeRange" />
                </div>

                <div class="filter-group custom-date-group" id="customDateGroup" style="display: @(Model.SelectedTimeRange == "custom" ? "flex" : "none");">
                    <label>From</label>
                    <input type="datetime-local" name="CustomFrom" id="customFrom" 
                           value="@(Model.CustomFromDate?.ToString("yyyy-MM-ddTHH:mm"))" />
                </div>
                
                <div class="filter-group custom-date-group" id="customDateGroupTo" style="display: @(Model.SelectedTimeRange == "custom" ? "flex" : "none");">
                    <label>To</label>
                    <input type="datetime-local" name="CustomTo" id="customTo" 
                           value="@(Model.CustomToDate?.ToString("yyyy-MM-ddTHH:mm"))" />
                </div>
                
                <div class="filter-group">
                    <label>Level</label>
                    <select name="Level" id="levelSelect">
                        <option value="">All Levels</option>
                        <option value="Verbose" selected="@(Model.SelectedLevel == "Verbose")">Verbose</option>
                        <option value="Debug" selected="@(Model.SelectedLevel == "Debug")">Debug</option>
                        <option value="Information" selected="@(Model.SelectedLevel == "Information")">Information</option>
                        <option value="Warning" selected="@(Model.SelectedLevel == "Warning")">Warning</option>
                        <option value="Error" selected="@(Model.SelectedLevel == "Error")">Error</option>
                        <option value="Fatal" selected="@(Model.SelectedLevel == "Fatal")">Fatal</option>
                    </select>
                </div>
                
                <div class="filter-actions">
                    <button type="submit" class="btn btn-primary" id="searchBtn">
                        Search
                    </button>
                    <a class="btn btn-secondary" id="resetBtn" href="/logs" title="Reset all filters to default (all applications, last 24h)">
                        Reset
                    </a>
                </div>
            </div>
            
            @if (Model.Logs.Count > 0)
            {
                <div class="toolbar-row search-row">
                    <div class="filter-group search-group">
                        <div class="search-input-wrapper">
                            <input type="text" placeholder="Filter results..." id="filterText" value="@Model.SearchText" />
                            <button type="button" class="btn-clear-search" id="clearFilterBtn" onclick="clearFilter()" title="Clear filter">×</button>
                        </div>
                        <span class="result-count" id="resultCount">@Model.Logs.Count loaded</span>
                    </div>
                </div>
            }
        </div>
    </form>
    
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-error">
            @Model.ErrorMessage
        </div>
    }
    
    @if (Model.HasSearched && Model.Logs.Count == 0)
    {
        <div class="no-results">
            <span class="no-results-icon">📭</span>
            <p>No logs found for the selected criteria.</p>
        </div>
    }
    else if (Model.Logs.Count > 0)
    {
        <div class="log-list" id="logList">
            @await Html.PartialAsync("_LogEntries", new LogEntriesViewModel
            {
                Logs = Model.Logs,
                ShowApplicationName = string.IsNullOrEmpty(Model.SelectedApplication),
                HasMore = Model.HasMore,
                NextCursor = Model.NextCursor
            })
        </div>

        @*
            Scroll sentinel: the viewer fetches the next page when this comes into view.

            The filters travel as data attributes and are assembled into the query string in script,
            rather than being handed to Url.Action — the app lowercases generated query strings, which
            would fold the case of an application name and send the next page at the wrong partition.
        *@
        <div class="log-list-footer" id="logListFooter"
             data-load-more-url="@Url.Action("LoadMore", "Home")"
             data-application="@Model.SelectedApplication"
             data-level="@Model.SelectedLevel"
             data-time-range="@Model.SelectedTimeRange"
             data-custom-from="@(Model.CustomFromDate?.ToString("yyyy-MM-ddTHH:mm:ss"))"
             data-custom-to="@(Model.CustomToDate?.ToString("yyyy-MM-ddTHH:mm:ss"))">
            <span class="log-list-status" id="logListStatus"></span>
        </div>
    }
    else if (!Model.HasSearched)
    {
        <div class="no-results">
            <span class="no-results-icon">🔍</span>
            <p>Select your filters and click Search to view logs.</p>
        </div>
    }
</div>


@section Scripts {
<script>
    let expandedLogId = null;

    // Loaded log data, in the same order as the .log-entry elements — the client-side filter pairs
    // them up by index. Each page appends to both, so the pairing holds as more pages arrive.
    const logs = [];
    let nextCursor = null;
    let hasMore = false;
    let pagesLoaded = 0;

    // Each rendered page carries its rows plus its own cursor in a JSON block (see _LogEntries).
    // Pull that out, fold the rows into `logs`, and drop the block so it isn't left in the list.
    function consumePageData(root) {
        const el = root.querySelector('.log-page-data');
        if (!el) return;
        let page;
        try {
            page = JSON.parse(el.textContent);
        } catch {
            hasMore = false;
            return;
        } finally {
            el.remove();
        }
        (page.logs || []).forEach(l => logs.push(l));
        nextCursor = page.nextCursor || null;
        hasMore = !!page.hasMore && !!nextCursor;
        pagesLoaded++;
    }

    consumePageData(document);

    // Convert UTC timestamps to local time on page load
    const monthAbbr = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    const weekdayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

    function formatLocalTime(date) {
        let hours = date.getHours();
        const ampm = hours >= 12 ? 'PM' : 'AM';
        hours = hours % 12 || 12;
        const hh = String(hours).padStart(2, '0');
        const minutes = String(date.getMinutes()).padStart(2, '0');
        return `${hh}:${minutes} ${ampm}`;
    }

    function formatDateHeader(date) {
        const startOfDay = d => new Date(d.getFullYear(), d.getMonth(), d.getDate());
        const diffDays = Math.round((startOfDay(new Date()) - startOfDay(date)) / 86400000);
        const label = `${String(date.getDate()).padStart(2, '0')} ${monthAbbr[date.getMonth()]} ${date.getFullYear()}`;
        if (diffDays === 0) return `Today, ${label}`;
        if (diffDays === 1) return `Yesterday, ${label}`;
        return `${weekdayNames[date.getDay()]}, ${label}`;
    }

    // Show local time only on each row and insert a sticky date header whenever the day changes.
    // Logs arrive newest-first, so a single walk groups them. Later pages continue that walk —
    // lastDateKey persists, so a day spanning a page boundary doesn't get a second header — and
    // entries are marked once handled so re-running only ever touches newly appended rows.
    let lastDateKey = null;

    function renderTimesAndDateGroups() {
        const logList = document.getElementById('logList');
        if (!logList) return;
        logList.querySelectorAll('.log-entry:not([data-time-rendered])').forEach(entry => {
            entry.setAttribute('data-time-rendered', '');
            const el = entry.querySelector('.log-timestamp[data-utc]');
            if (!el) return;
            const date = new Date(el.getAttribute('data-utc'));
            el.textContent = formatLocalTime(date);

            const dateKey = `${date.getFullYear()}-${date.getMonth()}-${date.getDate()}`;
            if (dateKey !== lastDateKey) {
                const header = document.createElement('div');
                header.className = 'log-date-header';
                header.textContent = formatDateHeader(date);
                logList.insertBefore(header, entry);
                lastDateKey = dateKey;
            }
        });
    }

    // Hide a date header when every entry in its group is filtered out.
    function updateDateHeaders() {
        const logList = document.getElementById('logList');
        if (!logList) return;
        let currentHeader = null;
        let visibleInGroup = 0;
        Array.from(logList.children).forEach(child => {
            if (child.classList.contains('log-date-header')) {
                if (currentHeader) currentHeader.style.display = visibleInGroup > 0 ? '' : 'none';
                currentHeader = child;
                visibleInGroup = 0;
            } else if (child.classList.contains('log-entry') && child.style.display !== 'none') {
                visibleInGroup++;
            }
        });
        if (currentHeader) currentHeader.style.display = visibleInGroup > 0 ? '' : 'none';
    }
    
    // Calculate and display relative time
    function updateRelativeTimes() {
        const now = new Date();
        document.querySelectorAll('.log-relative-time[data-utc]').forEach(el => {
            const utcStr = el.getAttribute('data-utc');
            if (utcStr) {
                const date = new Date(utcStr);
                const diffMs = now - date;
                const diffSec = Math.floor(diffMs / 1000);
                const diffMin = Math.floor(diffSec / 60);
                const diffHour = Math.floor(diffMin / 60);
                const diffDay = Math.floor(diffHour / 24);
                
                let relative;
                if (diffSec < 60) {
                    relative = diffSec <= 1 ? 'just now' : `${diffSec}s ago`;
                } else if (diffMin < 60) {
                    relative = diffMin === 1 ? '1 min ago' : `${diffMin} mins ago`;
                } else if (diffHour < 24) {
                    relative = diffHour === 1 ? '1 hour ago' : `${diffHour} hours ago`;
                } else if (diffDay < 30) {
                    relative = diffDay === 1 ? '1 day ago' : `${diffDay} days ago`;
                } else {
                    relative = '';
                }
                el.textContent = relative;
            }
        });
    }
    
    // Run on page load
    renderTimesAndDateGroups();
    updateRelativeTimes();
    
    function selectTimeRange(range) {
        document.getElementById('timeRangeInput').value = range;
        
        // Update button styles
        document.querySelectorAll('.time-range-buttons .btn').forEach(btn => {
            btn.classList.remove('btn-active');
            btn.classList.add('btn-secondary');
        });
        event.target.classList.remove('btn-secondary');
        event.target.classList.add('btn-active');
        
        // Show/hide custom date inputs
        const customGroups = document.querySelectorAll('.custom-date-group');
        customGroups.forEach(g => g.style.display = range === 'custom' ? 'flex' : 'none');
        
        // Set default custom dates if needed
        if (range === 'custom') {
            const now = new Date();
            const hourAgo = new Date(now.getTime() - 60 * 60 * 1000);
            if (!document.getElementById('customFrom').value) {
                document.getElementById('customFrom').value = formatLocalDateTime(hourAgo);
            }
            if (!document.getElementById('customTo').value) {
                document.getElementById('customTo').value = formatLocalDateTime(now);
            }
        }
    }
    
    // Format date for datetime-local input (local timezone)
    function formatLocalDateTime(date) {
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const day = String(date.getDate()).padStart(2, '0');
        const hours = String(date.getHours()).padStart(2, '0');
        const minutes = String(date.getMinutes()).padStart(2, '0');
        return `${year}-${month}-${day}T${hours}:${minutes}`;
    }
    
    function toggleLog(logId) {
        const details = document.getElementById('details-' + logId);
        const entry = details.closest('.log-entry');
        
        if (expandedLogId === logId) {
            details.style.display = 'none';
            entry.classList.remove('expanded');
            expandedLogId = null;
        } else {
            // Close previous
            if (expandedLogId) {
                const prevDetails = document.getElementById('details-' + expandedLogId);
                if (prevDetails) {
                    prevDetails.style.display = 'none';
                    prevDetails.closest('.log-entry').classList.remove('expanded');
                }
            }
            details.style.display = 'block';
            entry.classList.add('expanded');
            expandedLogId = logId;
        }
    }
    
    // Client-side filtering
    const filterInput = document.getElementById('filterText');
    const clearBtn = document.getElementById('clearFilterBtn');
    
    if (filterInput) {
        filterInput.addEventListener('input', function() {
            filterLogs(this.value);
            if (clearBtn) {
                clearBtn.style.display = this.value ? 'block' : 'none';
            }
        });
    }
    
    // A "scoped" filter of the form `Key = value` matches only logs that have a
    // property named Key whose value equals value exactly (case-insensitive), so
    // filtering CustomerId = 22 never picks up 221, 1022, or an unrelated 22 in a
    // message. We only treat the text as scoped when a property with that key
    // actually exists in the current results; otherwise it falls back to free-text
    // so a normal search containing "=" still works.
    function parseScopedFilter(searchText) {
        const m = searchText.match(/^([^\s=]+)\s*=\s*(.*)$/);
        if (!m) return null;
        const keyLower = m[1].toLowerCase();
        const exists = logs.some(l => l.properties &&
            Object.keys(l.properties).some(k => k.toLowerCase() === keyLower));
        if (!exists) return null;
        return { key: keyLower, value: m[2].toLowerCase() };
    }

    function filterLogs(searchText) {
        const entries = document.querySelectorAll('.log-entry');
        let visibleCount = 0;
        const searchLower = searchText.toLowerCase();
        const scoped = parseScopedFilter(searchText);

        entries.forEach((entry, index) => {
            const log = logs[index];
            if (!log) return;

            let matches;
            if (!searchText) {
                matches = true;
            } else if (scoped) {
                matches = false;
                if (log.properties) {
                    for (const [k, v] of Object.entries(log.properties)) {
                        if (k.toLowerCase() === scoped.key && String(v).toLowerCase() === scoped.value) {
                            matches = true;
                            break;
                        }
                    }
                }
            } else {
                let propsMatch = false;
                if (log.properties) {
                    for (const [k, v] of Object.entries(log.properties)) {
                        const keyMatch = k.toLowerCase().includes(searchLower);
                        const valStr = String(v).toLowerCase();
                        const valMatch = valStr.includes(searchLower);
                        if (keyMatch || valMatch) {
                            propsMatch = true;
                            break;
                        }
                    }
                }

                matches = log.message.toLowerCase().includes(searchLower) ||
                    (log.messageTemplate && log.messageTemplate.toLowerCase().includes(searchLower)) ||
                    (log.exception && log.exception.toLowerCase().includes(searchLower)) ||
                    propsMatch;
            }

            entry.style.display = matches ? '' : 'none';
            if (matches) visibleCount++;
        });
        
        updateResultCount(visibleCount);
        updateDateHeaders();
    }

    // Counts describe what has been loaded so far, not the whole time range — more pages may still
    // be waiting below the fold, so "results" would overstate it while there are.
    function updateResultCount(visibleCount) {
        const countEl = document.getElementById('resultCount');
        if (!countEl) return;
        const suffix = hasMore ? ' loaded so far' : ' results';
        countEl.textContent = visibleCount === logs.length
            ? logs.length + suffix
            : visibleCount + ' of ' + logs.length + suffix;
    }

    updateResultCount(logs.length);
    
    function clearFilter() {
        if (filterInput) {
            filterInput.value = '';
            filterLogs('');
        }
        if (clearBtn) {
            clearBtn.style.display = 'none';
        }
    }
    
    function filterByTemplate(template) {
        event.stopPropagation();
        if (filterInput) {
            filterInput.value = template;
            filterLogs(template);
        }
        if (clearBtn) {
            clearBtn.style.display = 'block';
        }
    }
    
    function filterByProperty(key, value) {
        event.stopPropagation();
        // Scope the filter to this exact property so e.g. CustomerId = 22 matches
        // only that field's value, not any log that happens to contain "22".
        const searchText = value !== '' ? key + ' = ' + value : key;
        if (filterInput) {
            filterInput.value = searchText;
            filterLogs(searchText);
        }
        if (clearBtn) {
            clearBtn.style.display = 'block';
        }
    }

    // Copy one log entry — message plus all its metadata — to the clipboard as JSON, so it can be
    // pasted straight into a ticket, chat, or AI prompt. Fields are drawn from the same loaded data
    // the filter uses (looked up by id, not row index, so it holds regardless of scroll position).
    // Empty fields are dropped and the human-meaningful ones lead, keeping the pasted object tidy.
    const COPY_JSON_FIELD_ORDER =
        ['timestamp', 'level', 'application', 'message', 'messageTemplate', 'exception', 'eventId', 'properties', 'id'];

    function buildLogJson(log) {
        const out = {};
        COPY_JSON_FIELD_ORDER.forEach(key => {
            const value = log[key];
            if (value === null || value === undefined || value === '') return;
            if (key === 'properties' && Object.keys(value).length === 0) return;
            out[key] = value;
        });
        return JSON.stringify(out, null, 2);
    }

    async function copyTextToClipboard(text) {
        // The async Clipboard API is only available in secure contexts; SignalYard is often reached
        // over plain HTTP on a LAN, so fall back to a hidden-textarea copy where it's unavailable.
        if (navigator.clipboard && window.isSecureContext) {
            try {
                await navigator.clipboard.writeText(text);
                return true;
            } catch { /* fall through */ }
        }
        try {
            const ta = document.createElement('textarea');
            ta.value = text;
            ta.setAttribute('readonly', '');
            ta.style.position = 'fixed';
            ta.style.top = '-1000px';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.select();
            const ok = document.execCommand('copy');
            document.body.removeChild(ta);
            return ok;
        } catch {
            return false;
        }
    }

    const COPY_ICON_OK = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>';
    const COPY_ICON_FAIL = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg>';

    function flashCopyButton(btn, ok) {
        if (!btn || btn.dataset.flashing) return;
        if (!btn.dataset.copyIcon) btn.dataset.copyIcon = btn.innerHTML;
        btn.dataset.flashing = '1';
        btn.classList.add(ok ? 'copied' : 'copy-failed');
        btn.innerHTML = ok ? COPY_ICON_OK : COPY_ICON_FAIL;
        setTimeout(() => {
            btn.classList.remove('copied', 'copy-failed');
            btn.innerHTML = btn.dataset.copyIcon;
            delete btn.dataset.flashing;
        }, 1200);
    }

    function copyLogJson(event, logId) {
        event.stopPropagation(); // don't toggle the row open/closed
        const btn = event.currentTarget;
        const log = logs.find(l => l.id === logId);
        if (!log) {
            flashCopyButton(btn, false);
            return;
        }
        copyTextToClipboard(buildLogJson(log)).then(ok => flashCopyButton(btn, ok));
    }

    // Infinite scroll. The server renders the first page only; the rest are fetched as the sentinel
    // below the list nears the viewport, which keeps the first render cheap on busy time ranges.
    (function () {
        const footer = document.getElementById('logListFooter');
        const logList = document.getElementById('logList');
        if (!footer || !logList) return;

        const status = document.getElementById('logListStatus');
        const baseUrl = footer.getAttribute('data-load-more-url');

        // The active filters, carried alongside the cursor so each page covers the same query.
        const filters = {
            application: footer.getAttribute('data-application'),
            level: footer.getAttribute('data-level'),
            timeRange: footer.getAttribute('data-time-range'),
            customFrom: footer.getAttribute('data-custom-from'),
            customTo: footer.getAttribute('data-custom-to')
        };

        function pageUrl(cursor) {
            const params = new URLSearchParams();
            Object.keys(filters).forEach(key => {
                if (filters[key]) params.set(key, filters[key]);
            });
            params.set('cursor', cursor);
            return baseUrl + '?' + params.toString();
        }

        // How many pages may load back-to-back without the user scrolling. A filter that hides every
        // new row leaves the sentinel on screen, so loading would otherwise chain indefinitely; this
        // caps the burst and hands control back with a "load more" prompt.
        const MAX_AUTO_LOADS = 20;

        let loading = false;
        let autoLoads = 0;

        function setStatus(text, state) {
            footer.className = 'log-list-footer' + (state ? ' is-' + state : '');
            status.textContent = text;
        }

        function nearViewport() {
            return footer.getBoundingClientRect().top < window.innerHeight + 600;
        }

        async function loadNextPage() {
            if (loading || !hasMore || !nextCursor) return;
            loading = true;
            setStatus('Loading more logs…', 'loading');

            try {
                const response = await fetch(pageUrl(nextCursor), {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                if (!response.ok) throw new Error('HTTP ' + response.status);

                const template = document.createElement('template');
                template.innerHTML = await response.text();

                // A signed-out session answers a redirect to the login page with 200 OK, so check we
                // were actually given a page of logs before putting anything in the list.
                if (!template.content.querySelector('.log-page-data')) {
                    throw new Error('Unexpected response');
                }

                consumePageData(template.content);
                logList.append(...template.content.children);

                renderTimesAndDateGroups();
                if (filterInput && filterInput.value) {
                    filterLogs(filterInput.value);
                } else {
                    updateResultCount(logs.length);
                }

                setStatus(hasMore ? '' : logs.length + ' logs loaded — end of results.',
                    hasMore ? null : 'done');
            } catch {
                setStatus('Could not load more logs. Click to retry.', 'error');
                loading = false;
                return;
            }

            loading = false;

            // The list may still fall short of the viewport — a tall screen, or a filter hiding
            // everything that just arrived — in which case scrolling can't trigger the next page.
            if (hasMore && nearViewport() && ++autoLoads < MAX_AUTO_LOADS) {
                loadNextPage();
            } else if (hasMore && autoLoads >= MAX_AUTO_LOADS) {
                setStatus('Load more logs', 'more');
            }
        }

        footer.addEventListener('click', function () {
            if (!loading && hasMore) {
                autoLoads = 0;
                loadNextPage();
            }
        });

        window.addEventListener('scroll', function () {
            autoLoads = 0;
        }, { passive: true });

        if (!hasMore) {
            footer.style.display = 'none';
            return;
        }

        if ('IntersectionObserver' in window) {
            new IntersectionObserver(function (entries) {
                if (entries.some(e => e.isIntersecting)) loadNextPage();
            }, { rootMargin: '600px 0px' }).observe(footer);
        } else {
            window.addEventListener('scroll', function () {
                if (nearViewport()) loadNextPage();
            }, { passive: true });
        }
    })();

    // Pause the auto-refresh countdown while the user is mid-interaction — typing or
    // reading a client-side filter, reading an expanded entry, or having scrolled far enough
    // to pull in further pages — so a reload doesn't wipe their state out from under them.
    // The countdown resumes once they're idle.
    window.signalYardShouldPauseRefresh = function () {
        const filtering = filterInput && (filterInput.value || document.activeElement === filterInput);
        return !!(filtering || expandedLogId || pagesLoaded > 1);
    };
</script>

@await Html.PartialAsync("_AutoRefresh")
}
